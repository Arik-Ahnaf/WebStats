{
  "name": "webstats",
  "version": "1.0.0",
  "description": "Private, on-device active website time tracking.",
  "private": true,
  "engines": { "node": "^22.12.0 || ^24.0.0 || >=26.0.0" },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/verify-chromium.mjs",
    "postinstall": "wxt prepare"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "wxt": "^0.21.4"
  }
}
